{
    "name": "nescafe-parent",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "npm install --prefix frontend && npm run build --prefix frontend",
        "dev": "concurrently -k -n \"WEB,SERVER\" -c \"cyan,magenta\" \"npm run frontend:start\" \"npm run backend:dev\"",
        "frontend:start": "npm start --prefix frontend",
        "frontend:build": "npm run build --prefix frontend",
        "backend:start": "npm start --prefix backend",
        "backend:dev": "npm run dev --prefix backend",
        "install-all": "npm install --prefix frontend && npm install --prefix backend",
        "postinstall": "npm install --prefix frontend"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.39.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "razorpay": "^2.9.2"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}